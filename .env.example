# Base de datos (Turso / libsql).
# En local puedes dejar TURSO_DATABASE_URL vacío y se usará file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secreto para firmar el JWT de sesión. Obligatorio.
# Genéralo con: openssl rand -base64 48
JWT_SECRET=

# Hash scrypt de la contraseña del panel. Obligatorio.
# Genéralo con: node scripts/hash-password.mjs "tu-contraseña"
ADMIN_PASSWORD_HASH=
